<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- Fixes the tiny/half-screen scaling issue on Android APK -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#003d7a">
    <title>IAPMD App</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            background: #f0f7ff;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* ── Splash Screen (Shows Logo in Middle on App Open) ── */
        #splash-screen {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background-color: #000000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.6s ease, visibility 0.6s ease;
        }

        #splash-screen.fade-out {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .splash-logo {
            width: 200px;
            max-width: 60vw;
            height: auto;
            animation: logoPop 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        @keyframes logoPop {
            0% {
                opacity: 0;
                transform: scale(0.75);
            }
            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* ── Main App Wrapper ── */
        .iapmd-footer-wrapper {
            width: 100%;
            min-height: 100vh;
            margin: 0 auto;
            background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%);
            display: flex;
            flex-direction: column;
        }

        /* ── Letterhead / App Header ── */
        .iapmd-letterhead-compact {
            background: linear-gradient(135deg, #003d7a 0%, #0057B8 60%, #0077cc 100%);
            color: #ffffff;
            padding: 24px 18px 20px;
            position: relative;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            box-shadow: 0 4px 14px rgba(0, 61, 122, 0.2);
        }

        .iapmd-letterhead-compact::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #00ffff, #00AEEF, #00ffff);
        }

        .iapmd-logo-wrap {
            flex-shrink: 0;
        }

        .iapmd-logo-wrap img {
            width: 68px;
            height: 68px;
            object-fit: contain;
            filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.25));
        }

        .letterhead-text {
            flex: 1;
        }

        .letterhead-text h1 {
            font-family: 'Cinzel', serif;
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 4px 0;
            letter-spacing: 0.5px;
            line-height: 1.3;
            color: #ffffff;
        }

        .letterhead-text h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 14px;
            font-weight: 600;
            margin: 0 0 6px 0;
            line-height: 1.3;
            color: #aeeeff;
            font-style: italic;
        }

        .ros {
            font-size: 11px;
            color: #88ccff;
            margin-bottom: 8px;
        }

        .secretariat {
            font-size: 12px;
            line-height: 1.5;
            color: #cce6ff;
            margin-bottom: 8px;
        }

        .secretariat strong {
            color: #ffffff;
            font-weight: 600;
            font-size: 13px;
        }

        .contact {
            font-size: 12px;
            line-height: 1.6;
            color: #aaddff;
        }

        .contact a {
            color: #66ccff;
            text-decoration: none;
        }

        /* ── Quick Links Title ── */
        .ql-header {
            text-align: center;
            padding: 20px 12px 8px;
        }

        .ql-header h3 {
            font-family: 'Cinzel', serif;
            font-size: 20px;
            font-weight: 700;
            margin: 0;
            letter-spacing: 2px;
            text-transform: uppercase;
            background: linear-gradient(90deg, #0057B8, #00AEEF, #0057B8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            background-size: 200% auto;
            animation: shimmer 4s linear infinite;
        }

        .ql-header::after {
            content: '';
            display: block;
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #00AEEF, transparent);
            margin: 8px auto 0;
            border-radius: 2px;
        }

        @keyframes shimmer {
            0% { background-position: 0% center; }
            100% { background-position: 200% center; }
        }

        /* ── Quick Links Grid (Mobile-First Large Icons) ── */
        .iapmd-dashboard {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px 12px;
            width: 100%;
            padding: 16px 16px 28px;
            flex: 1;
        }

        .app-btn {
            text-decoration: none;
            text-align: center;
            color: #1f2937;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: transform 0.15s ease;
        }

        .app-btn:active {
            transform: scale(0.92);
        }

        .app-btn div {
            width: 68px;
            height: 68px;
            border-radius: 18px;
            background: linear-gradient(135deg, #0057B8, #00AEEF);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            box-shadow: 0 4px 12px rgba(0, 87, 184, 0.25);
            transition: all 0.2s ease;
        }

        .app-btn span {
            display: block;
            margin-top: 8px;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.25;
            color: #1e293b;
            letter-spacing: 0.2px;
        }

        /* ── Copyright ── */
        .footer-copyright {
            text-align: center;
            padding: 16px;
            font-size: 12px;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
            margin-top: auto;
        }

        /* ── Larger Tablets & Desktops ── */
        @media (min-width: 600px) {
            .iapmd-dashboard {
                grid-template-columns: repeat(4, 1fr);
                gap: 20px 16px;
                padding: 20px 24px 32px;
            }
        }

        @media (min-width: 900px) {
            .iapmd-footer-wrapper {
                max-width: 900px;
                margin: 20px auto;
                min-height: auto;
                border-radius: 16px;
                box-shadow: 0 4px 24px rgba(0, 87, 184, 0.08);
                overflow: hidden;
            }
            .iapmd-dashboard {
                grid-template-columns: repeat(5, 1fr);
            }
        }
    </style>
</head>
<body>

